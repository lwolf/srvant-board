	)
	(text "2.13. Global_EN\nPulling this pin low puts the CM4 in the lowest possible power down state. After software shutdown Global_EN needs to\nbe pulled low for > 1ms to restart the power system on the CM4.\n\n2.14. RUN_PG\nThis pin when high signals that the CM4 has started. Driving this pin low resets the module, this should be done with\ncaution as if files on a filesystem are open they will not be closed\n\n2.15. nRPI_BOOT\nDuring boot if this pin is low booting from eMMC will be stopped and booting will be transferred to rpi boot which is via\nUSB."
		(exclude_from_sim no)
		(at 636.778 181.864 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "aa92aa63-2fa8-45b6-bed6-5780fd8be3c6")
	)
